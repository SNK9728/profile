<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="675" viewBox="0 0 1200 675" fill="none">
  <rect width="1200" height="675" fill="#0D0D0D"/>
  <rect x="1" y="1" width="1198" height="673" rx="12" stroke="#292929" stroke-width="2"/>
  
  <path d="M0 100H1200M0 200H1200M0 300H1200M0 400H1200M0 500H1200M0 600H1200" stroke="#1A1A1A" stroke-width="1"/>
  <path d="M200 0V675M400 0V675M600 0V675M800 0V675M1000 0V675" stroke="#1A1A1A" stroke-width="1"/>
  
  <!-- TDS Sensor Graphic -->
  <rect x="530" y="150" width="140" height="320" rx="10" fill="#141414" stroke="#FF6B00" stroke-width="3"/>
  <rect x="580" y="470" width="40" height="120" fill="#222222"/>
  <circle cx="600" cy="230" r="30" fill="#111" stroke="#FF6B00" stroke-width="2"/>
  <text x="600" y="236" fill="#FF6B00" font-family="Inter, sans-serif" font-size="14" font-weight="800" text-anchor="middle">TDS</text>
  
  <!-- Digital Display Graphic -->
  <rect x="120" y="240" width="300" height="180" rx="10" fill="#111" stroke="#333" stroke-width="2"/>
  <text x="270" y="300" fill="#F5F5F5" font-family="Inter, sans-serif" font-size="20" font-weight="700" text-anchor="middle">WATER QUALITY</text>
  <text x="270" y="355" fill="#FF6B00" font-family="Consolas, monospace" font-size="32" font-weight="700" text-anchor="middle">248 PPM</text>
  
  <path d="M420 330 H530" stroke="#FF6B00" stroke-width="3" stroke-dasharray="6 6"/>
  
  <!-- Card Label -->
  <rect x="760" y="270" width="340" height="135" rx="10" fill="#111" stroke="#333" stroke-width="2"/>
  <text x="930" y="325" fill="#F5F5F5" font-family="Inter, sans-serif" font-size="20" font-weight="700" text-anchor="middle">Project Image</text>
  <text x="930" y="360" fill="#A0A0A0" font-family="Inter, sans-serif" font-size="14" font-weight="400" text-anchor="middle">TDS-Based Water Quality Tester</text>
</svg>
